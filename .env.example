# Copy this file to `.env` and fill in the values.
#
# Only variables prefixed with VITE_ are exposed to the client by Vite, and
# every one of them is inlined into the JavaScript bundle at build time.
# Anything placed here is therefore PUBLIC — never put an API key, client
# secret or password in this file.
#
# Load order: `.env` applies to every mode; `.env.development` is layered on
# top of it by `npm run dev`. Machine-specific overrides belong in `.env.local`
# or `.env.development.local`, which are git-ignored.

# Base URL of the kod.is Web API, including the trailing `/api` segment.
# Every request made through src/api.js is resolved against this value.
#   Deployed API:  https://kodisapi.kod.is/api
#   Local API:     http://localhost:5247/api   (or https://localhost:7122/api
#                  once `dotnet dev-certs https --trust` has been run)
VITE_API_BASE_URL=
