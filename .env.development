# `npm run dev` bu dosyayi kullanir ve .env'i ezer.
#
# Lokal API'yi calistir:  dotnet run --project ../KodisApp/KodisApi
#
# HTTP portu bilerek secildi: .NET dev sertifikasi guvenilir degilse tarayici
# https://localhost:7122'ye giden istekleri sertifika hatasiyla engeller.
# `dotnet dev-certs https --trust` calistirdiysan https://localhost:7122/api da olur.
VITE_API_BASE_URL=http://localhost:5247/api
